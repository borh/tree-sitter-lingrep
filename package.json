{
  "name": "tree-sitter-lingrep",
  "version": "0.1.0",
  "description": "Grammar for lingrep patterns",
  "repository": "https://github.com/borh/tree-sitter-lingrep.git",
  "license": "MIT",
  "author": {
    "name": "Bor Hodošček",
    "email": "dev@bor.space"
  },
  "main": "bindings/node/index.js",
  "types": "bindings/node/index.d.ts",
  "keywords": [
    "incremental",
    "parsing",
    "tree-sitter",
    "lingrep"
  ],
  "files": [
    "grammar.js",
    "binding.gyp",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "dependencies": {
    "node-addon-api": "^8.1.0",
    "node-gyp-build": "^4.8.2"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.26.11"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "scripts": {
    "install": "node-gyp-build",
    "prestart": "tree-sitter build --wasm",
    "start": "tree-sitter playground",
    "test": "node --test bindings/node/*_test.js"
  },
  "tree-sitter": [
    {
      "scope": "source.lingrep",
      "injection-regex": "^lingrep$"
    }
  ],
  "type": "module"
}
