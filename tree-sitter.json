{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "lingrep",
      "camelcase": "Lingrep",
      "scope": "source.lingrep",
      "path": ".",
      "file-types": [
        "lx"
      ],
      "highlights": "queries/lingrep/highlights.scm",
      "injections": "queries/lingrep/injections.scm",
      "injection-regex": "^lingrep$"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Grammar for lingrep patterns",
    "authors": [
      {
        "name": "Bor Hodošček",
        "email": "dev@bor.space"
      }
    ],
    "links": {
      "repository": "https://github.com/borh/tree-sitter-lingrep"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
